# Variáveis para desenvolvimento local (Windows/Linux fora do Replit).
# Copie para `.env` na raiz e ajuste. O `.env` NÃO é versionado.
# No Replit estas variáveis são injetadas pelo ambiente e este arquivo não é usado.

# Conexão PostgreSQL (usada pela API e pelo `pnpm --filter @workspace/db run push`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/miolo

# Porta da API (lida apenas pela api-server). O frontend roda na 5173 e
# encaminha /api para esta porta (se mudar aqui, rode o Vite com API_PORT igual).
PORT=5000

NODE_ENV=development
